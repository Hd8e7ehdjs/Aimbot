--==================== SPEED ====================
local function applySpeed()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.WalkSpeed = CONFIG.SpeedEnabled and CONFIG.SpeedValue or 16
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    applySpeed()
end)

task.spawn(function()
    while task.wait(0.3) do
        if CONFIG.SpeedEnabled then
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.WalkSpeed ~= CONFIG.SpeedValue then
                hum.WalkSpeed = CONFIG.SpeedValue
            end
        end
    end
end)

--==================== DASH (Shift) ====================
local dashActive = false
UserInput.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.LeftShift and CONFIG.DashEnabled and not dashActive then
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end

        dashActive = true
        local original = hum.WalkSpeed
        hum.WalkSpeed = CONFIG.DashValue

        local dir = Camera.CFrame.LookVector
        hrp.AssemblyLinearVelocity = Vector3.new(dir.X * CONFIG.DashValue, 0, dir.Z * CONFIG.DashValue)

        task.delay(0.35, function()
            hum.WalkSpeed = original
            dashActive = false
        end)
    end
end)

--==================== WALK ON WATER ====================
local originalWaterSize = nil
local walkWaterConn     = nil

local function setWalkOnWater(state)
    if state then
        if walkWaterConn then return end
        local map   = Workspace:FindFirstChild("Map")
        local water = map and map:FindFirstChild("WaterBase-Plane")
        if not water then return end

        if not originalWaterSize then
            originalWaterSize = water.Size
        end

        walkWaterConn = RunService.Heartbeat:Connect(function()
            local m = Workspace:FindFirstChild("Map")
            local w = m and m:FindFirstChild("WaterBase-Plane")
            if w then
                w.Size = Vector3.new(1000, 113, 1000)
            end
        end)
    else
        if walkWaterConn then
            walkWaterConn:Disconnect()
            walkWaterConn = nil
        end
        local map   = Workspace:FindFirstChild("Map")
        local water = map and map:FindFirstChild("WaterBase-Plane")
        if water and originalWaterSize then
            water.Size = originalWaterSize
        end
    end
end

