getgenv().AimbotFOV   = function(v) CONFIG.FOV = v or 0 end
getgenv().AimbotTeam  = function(v) CONFIG.TeamCheck = v and true or false end
getgenv().AimbotDist  = function(v) CONFIG.MaxDistance = v or 2000 end
getgenv().HUB_Config  = CONFIG
