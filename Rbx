--==================== SAFE ZONE ====================
local SafeZoneParts = {}
local function refreshSafeZones()
    table.clear(SafeZoneParts)
    for _, part in ipairs(Workspace:GetChildren()) do
        if part:IsA("BasePart")
           and (part.Name:find("SafeZone") or part.Name:find("PeaceZone")) then
            table.insert(SafeZoneParts, part)
        end
    end
end
refreshSafeZones()
task.spawn(function()
    while task.wait(5) do refreshSafeZones() end
end)

local function isSafeZone(player)
    if not player.Character then return true end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return true end
    if player.Character:FindFirstChild("ForceField") then return true end
    for _, part in ipairs(SafeZoneParts) do
        if part.Parent
           and (hrp.Position - part.Position).Magnitude < part.Size.Magnitude / 2 + 10 then
            return true
        end
    end
    return false
end

local function isSameTeam(player)
    if not CONFIG.TeamCheck then return false end
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function getTeamColor(player)
    if player.Team and player.Team.TeamColor then
        return player.Team.TeamColor.Color
    end
    return Color3.fromRGB(255, 255, 255)
end

--==================== PREDIÇÃO ====================
local function predictPosition(hrp)
    if not hrp then return nil end
    local pred = CONFIG.PredictionAmount
    if pred <= 0 then return hrp.Position end
    local vel = hrp.AssemblyLinearVelocity or hrp.Velocity
    if not vel then return hrp.Position end
    return hrp.Position + (vel * pred)
end

--==================== SELETOR DE ALVO (Player + NPC) ====================
local function isValidTarget(plr)
    if plr == LocalPlayer then return false end
    if not plr.Character or not plr.Character.Parent then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character.PrimaryPart
    if not (hum and hum.Health > 0 and hrp) then return false end
    if isSameTeam(plr) then return false end
    if isSafeZone(plr) then return false end
    return true
end

local function isValidNPC(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not (hum and hum.Health > 0 and hrp) then return false end
    return true
end

local function updateTarget()
    CachedMyHRP = LocalPlayer.Character
        and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
             or LocalPlayer.Character.PrimaryPart)

    if not CachedMyHRP or not CONFIG.EnableAimbot then
        CachedTarget, CachedTargetHRP, CachedAimPos = nil, nil, nil
        CachedTargetIsNPC = false
        return
    end

    local myPos = CachedMyHRP.Position
    local best, bestHRP, bestDist, bestIsNPC = nil, nil, math.huge, false

    if CONFIG.AimbotSkillsPlayer then
        for _, plr in ipairs(Players:GetPlayers()) do
            if isValidTarget(plr) then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                          or plr.Character.PrimaryPart
                local dist = (hrp.Position - myPos).Magnitude
                if dist < bestDist and dist <= CONFIG.MaxDistance then
                    bestDist, best, bestHRP, bestIsNPC = dist, plr, hrp, false
                end
            end
        end
    end

    if CONFIG.AimbotSkillsNPC and EnemiesFolder then
        for _, npc in ipairs(EnemiesFolder:GetChildren()) do
            if isValidNPC(npc) then
                local hrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
                local dist = (hrp.Position - myPos).Magnitude
                if dist < bestDist and dist <= CONFIG.MaxDistance then
                    bestDist, best, bestHRP, bestIsNPC = dist, npc, hrp, true
                end
            end
        end
    end

    CachedTarget       = best
    CachedTargetHRP    = bestHRP
    CachedTargetIsNPC  = bestIsNPC
    if bestHRP then
        local head = bestHRP.Parent:FindFirstChild("Head") or bestHRP
        CachedAimPos = head.Position
    else
        CachedAimPos = nil
    end
end

--==================== HOOK __namecall (AIMBOT) ====================
do
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if CONFIG.EnableAimbot and CachedAimPos then
                local method = getnamecallmethod()
                if method ~= "Fire" and method ~= "InvokeServer"
                   and method ~= "Raycast" and method ~= "FindPartOnRay"
                   and method ~= "FindPartOnRayWithIgnoreList" then
                    local args = {...}
                    for i = 1, math.min(4, #args) do
                        local v = args[i]
                        local tv = typeof(v)
                        if tv == "Vector3" then
                            args[i] = CachedAimPos
                            return old(self, unpack(args))
                        elseif tv == "CFrame" then
                            args[i] = CFrame.new(v.Position, CachedAimPos)
                            return old(self, unpack(args))
                        end
                    end
                end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
end

--==================== TRACER (Player - Drawing) ====================
local DrawingLine = nil
local TracerBeam, TracerA, TracerB = nil, nil, nil

local function destroyPlayerTracer()
    if DrawingLine then pcall(function() DrawingLine:Remove() end) DrawingLine = nil end
    if TracerBeam and TracerBeam.Parent then TracerBeam:Destroy() end
    if TracerA and TracerA.Parent then TracerA:Destroy() end
    if TracerB and TracerB.Parent then TracerB:Destroy() end
    TracerBeam, TracerA, TracerB = nil, nil, nil
end

local function updatePlayerTracer()
    if not CONFIG.EnableTracer or CachedTargetIsNPC
       or not CachedTargetHRP or not CachedTargetHRP.Parent then
        destroyPlayerTracer()
        return
    end

    if CONFIG.UseDrawing and Drawing then
        if not DrawingLine then
            DrawingLine = Drawing.new("Line")
            DrawingLine.Thickness    = 1.5
            DrawingLine.Color        = CONFIG.TracerColor
            DrawingLine.Transparency = 1
            DrawingLine.Visible      = true
        end
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local sp, onScreen = Camera:WorldToViewportPoint(CachedTargetHRP.Position)
        if onScreen then
            DrawingLine.From    = center
            DrawingLine.To      = Vector2.new(sp.X, sp.Y)
            DrawingLine.Visible = true
        else
            DrawingLine.Visible = false
        end
        return
    end

    if not TracerBeam or not TracerBeam.Parent
       or not TracerB or TracerB.Parent ~= CachedTargetHRP.Parent then
        destroyPlayerTracer()
        local myHead = LocalPlayer.Character
            and (LocalPlayer.Character:FindFirstChild("Head")
                 or LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
        local tgtHead = CachedTargetHRP.Parent:FindFirstChild("Head") or CachedTargetHRP
        if not myHead or not tgtHead then return end

        TracerA = Instance.new("Attachment", myHead)
        TracerB = Instance.new("Attachment", tgtHead)
        TracerBeam = Instance.new("Beam")
        TracerBeam.Attachment0   = TracerA
        TracerBeam.Attachment1   = TracerB
        TracerBeam.Color         = ColorSequence.new(CONFIG.TracerColor)
        TracerBeam.Width0        = CONFIG.TracerThick
        TracerBeam.Width1        = CONFIG.TracerThick
        TracerBeam.FaceCamera    = true
        TracerBeam.LightEmission = 1
        TracerBeam.Transparency  = NumberSequence.new(0.2)
        TracerBeam.Parent        = Workspace
    end
end

--==================== TRACER (NPC - Beam) ====================
local NPCBeam, NPCA, NPCB = nil, nil, nil

local function destroyNPCTracer()
    if NPCBeam and NPCBeam.Parent then NPCBeam:Destroy() end
    if NPCA and NPCA.Parent then NPCA:Destroy() end
    if NPCB and NPCB.Parent then NPCB:Destroy() end
    NPCBeam, NPCA, NPCB = nil, nil, nil
end

local function updateNPCTracer()
    if not CONFIG.NPCTracers or not CachedTargetIsNPC
       or not CachedTargetHRP or not CachedTargetHRP.Parent then
        destroyNPCTracer()
        return
    end

    local myHead = LocalPlayer.Character
        and (LocalPlayer.Character:FindFirstChild("Head")
             or LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
    local tgtHead = CachedTargetHRP.Parent:FindFirstChild("Head") or CachedTargetHRP
    if not myHead or not tgtHead then destroyNPCTracer() return end

    if not NPCBeam or not NPCBeam.Parent
       or not NPCB or NPCB.Parent ~= tgtHead then
        destroyNPCTracer()
        NPCA = Instance.new("Attachment", myHead)
        NPCB = Instance.new("Attachment", tgtHead)
        NPCBeam = Instance.new("Beam")
        NPCBeam.Attachment0   = NPCA
        NPCBeam.Attachment1   = NPCB
        NPCBeam.Color         = ColorSequence.new(CONFIG.NPCColor)
        NPCBeam.Width0        = 0.2
        NPCBeam.Width1        = 0.2
        NPCBeam.FaceCamera    = true
        NPCBeam.LightEmission = 1
        NPCBeam.Transparency  = NumberSequence.new(0.2)
        NPCBeam.Parent        = Workspace
    end
end

--==================== ESP ====================
local espCache = {}

local function clearESP(plr)
    local d = espCache[plr]
    if not d then return end
    if d.name  then pcall(function() d.name:Remove()  end) end
    if d.level then pcall(function() d.level:Remove() end) end
    if d.pvp   then pcall(function() d.pvp:Remove()   end) end
    if d.hp    then pcall(function() d.hp:Remove()    end) end
    if d.dist  then pcall(function() d.dist:Remove()  end) end
    espCache[plr] = nil
end

local function createESP(plr)
    if espCache[plr] then return espCache[plr] end
    if not Drawing then return nil end
    local d = {}

    d.name = Drawing.new("Text")
    d.name.Size         = 15
    d.name.Center       = true
    d.name.Outline      = true
    d.name.OutlineColor = Color3.new(0, 0, 0)
    d.name.Visible      = false

    d.level = Drawing.new("Text")
    d.level.Size         = 14
    d.level.Center       = true
    d.level.Outline      = true
    d.level.OutlineColor = Color3.new(0, 0, 0)
    d.level.Visible      = false

    d.pvp = Drawing.new("Text")
    d.pvp.Size         = 13
    d.pvp.Center       = true
    d.pvp.Outline      = true
    d.pvp.OutlineColor = Color3.new(0, 0, 0)
    d.pvp.Visible      = false

    d.hp = Drawing.new("Text")
    d.hp.Size         = 12
    d.hp.Center       = true
    d.hp.Outline      = true
    d.hp.OutlineColor = Color3.new(0, 0, 0)
    d.hp.Visible      = false

    d.dist = Drawing.new("Text")
    d.dist.Size         = 12
    d.dist.Center       = true
    d.dist.Outline      = true
    d.dist.OutlineColor = Color3.new(0, 0, 0)
    d.dist.Visible      = false

    espCache[plr] = d
    return d
end

local function getPlayerLevel(plr)
    local ok, lvl = pcall(function()
        return plr.Data.Level.Value
    end)
    if ok and lvl then return lvl end
    return "?"
end

local function isPvPActive(plr)
    local char = plr.Character
    if not char then return false end
    if char:FindFirstChild("ForceField") then return false end
    if plr:GetAttribute("PvpDisabled") == true then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    for _, part in ipairs(SafeZoneParts) do
        if part.Parent and (hrp.Position - part.Position).Magnitude < part.Size.Magnitude / 2 + 10 then
            return false
        end
    end
    return true
end

local function updateESP()
    if not CONFIG.EnableESP or not Drawing then
        for plr in pairs(espCache) do clearESP(plr) end
        return
    end

    local myChar = LocalPlayer.Character
    local myHRP  = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then
            if espCache[plr] then clearESP(plr) end
            continue
        end

        local char = plr.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local hrp  = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        local head = char and char:FindFirstChild("Head")

        if char and hum and hum.Health > 0 and hrp and head and myHRP then
            local d = espCache[plr] or createESP(plr)
            if d then
                local sp, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 3.0, 0))
                if onScreen then
                    local color = getTeamColor(plr)
                    local dist  = math.floor((hrp.Position - myHRP.Position).Magnitude)
                    local level = getPlayerLevel(plr)
                    local pvpOn = isPvPActive(plr)
                    local hp    = math.floor(hum.Health)
                    local maxHp = math.floor(hum.MaxHealth)

                    d.name.Text     = plr.Name
                    d.name.Position = Vector2.new(sp.X, sp.Y - 48)
                    d.name.Color    = color
                    d.name.Visible  = true

                    if CONFIG.ESPShowLevel then
                        d.level.Text     = "[ Lv. " .. tostring(level) .. " ]"
                        d.level.Position = Vector2.new(sp.X, sp.Y - 32)
                        d.level.Color    = Color3.fromRGB(140, 120, 255)
                        d.level.Visible  = true
                    else
                        d.level.Visible = false
                    end

                    if CONFIG.ESPShowPvP then
                        if pvpOn then
                            d.pvp.Text  = "PvP ATIVADO"
                            d.pvp.Color = Color3.fromRGB(0, 255, 80)
                        else
                            d.pvp.Text  = "PvP DESATIVADO"
                            d.pvp.Color = Color3.fromRGB(255, 60, 60)
                        end
                        d.pvp.Position = Vector2.new(sp.X, sp.Y - 16)
                        d.pvp.Visible  = true
                    else
                        d.pvp.Visible = false
                    end

                    if CONFIG.ESPShowHP then
                        d.hp.Text     = "HP " .. hp .. "/" .. maxHp
                        d.hp.Position = Vector2.new(sp.X, sp.Y)
                        d.hp.Color    = Color3.fromRGB(120, 230, 150)
                        d.hp.Visible  = true
                    else
                        d.hp.Visible = false
                    end

                    if CONFIG.ESPShowDist then
                        d.dist.Text     = tostring(dist) .. "m"
                        d.dist.Position = Vector2.new(sp.X, sp.Y + 14)
                        d.dist.Color    = Color3.fromRGB(200, 200, 200)
                        d.dist.Visible  = true
                    else
                        d.dist.Visible = false
                    end
                else
                    d.name.Visible  = false
                    d.level.Visible = false
                    d.pvp.Visible   = false
                    d.hp.Visible    = false
                    d.dist.Visible  = false
                end
            end
        else
            clearESP(plr)
        end
    end
end

