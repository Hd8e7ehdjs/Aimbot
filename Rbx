--==================== FAST ATTACK ====================
local lastAttack = 0
task.spawn(function()
    while task.wait(0.1) do
        if CONFIG.FastAttack and CachedTargetHRP and CachedTargetHRP.Parent then
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then
                local myHRP = char:FindFirstChild("HumanoidRootPart")
                if myHRP then
                    local dist = (CachedTargetHRP.Position - myHRP.Position).Magnitude
                    if dist <= CONFIG.FADistance then
                        local remote = tool:FindFirstChild("LeftClickRemote")
                        if remote and tick() - lastAttack > 0.08 then
                            lastAttack = tick()
                            pcall(function() remote:FireServer() end)
                        end
                    end
                end
            end
        end
    end
end)

