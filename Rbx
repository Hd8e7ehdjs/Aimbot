    uiList.Padding = UDim.new(0, 6)
    uiList.SortOrder = Enum.SortOrder.LayoutOrder

    local minimized = false
    local ROW_H = 32
    local SECTION_H = 20

    local function recalc()
        if minimized then
            frame.Size = UDim2.new(0, 240, 0, 40)
            scroll.Visible = false
            minBtn.Text = "+"
        else
            local contentHeight = uiList.AbsoluteContentSize.Y + 8
            local maxVisible = 380
            local visibleH = math.min(contentHeight, maxVisible)

            frame.Size = UDim2.new(0, 240, 0, 38 + visibleH + 10)
            scroll.Size = UDim2.new(1, -16, 0, visibleH + 4)
            scroll.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
            scroll.Visible = true
            minBtn.Text = "−"
        end
    end

    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        recalc()
    end)

    uiList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        task.defer(recalc)
    end)

    local function makeToggle(text, getState, setState)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, ROW_H)
        btn.BackgroundColor3 = getState() and Color3.fromRGB(70, 160, 110)
                                             or Color3.fromRGB(55, 55, 70)
        btn.TextColor3 = Color3.fromRGB(230, 230, 240)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.Text = text .. ": " .. (getState() and "ON" or "OFF")
        btn.BorderSizePixel = 0
        btn.Parent = scroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        btn.MouseButton1Click:Connect(function()
            local new = not getState()
            setState(new)
            btn.BackgroundColor3 = new and Color3.fromRGB(70, 160, 110)
                                       or Color3.fromRGB(55, 55, 70)
            btn.Text = text .. ": " .. (new and "ON" or "OFF")
        end)

        return btn
    end

    local function makeSection(name)
        local wrap = Instance.new("Frame")
        wrap.Size = UDim2.new(1, -8, 0, SECTION_H)
        wrap.BackgroundTransparency = 1
        wrap.Parent = scroll

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = "▸ " .. name:upper()
        lbl.TextColor3 = Color3.fromRGB(140, 120, 255)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = wrap
    end

    -- AIMBOT
    makeSection("Aimbot")
    makeToggle("Aimbot", function() return CONFIG.EnableAimbot end,
        function(v) CONFIG.EnableAimbot = v end)
    makeToggle("Aimbot Players", function() return CONFIG.AimbotSkillsPlayer end,
        function(v) CONFIG.AimbotSkillsPlayer = v end)
    makeToggle("Aimbot NPCs", function() return CONFIG.AimbotSkillsNPC end,
        function(v) CONFIG.AimbotSkillsNPC = v end)
    makeToggle("Camlock", function() return CONFIG.CamlockEnabled end,
        function(v) CONFIG.CamlockEnabled = v end)
    makeToggle("Team Check", function() return CONFIG.TeamCheck end,
        function(v) CONFIG.TeamCheck = v end)

    -- TRACER
    makeSection("Tracer")
    makeToggle("Tracer (Player)", function() return CONFIG.EnableTracer end,
        function(v)
            CONFIG.EnableTracer = v
            if not v then destroyPlayerTracer() end
        end)
    makeToggle("Tracer (NPC)", function() return CONFIG.NPCTracers end,
        function(v)
            CONFIG.NPCTracers = v
            if not v then destroyNPCTracer() end
        end)

    -- ESP
    makeSection("ESP")
    makeToggle("ESP", function() return CONFIG.EnableESP end,
        function(v)
            CONFIG.EnableESP = v
            if not v then
                for plr in pairs(espCache) do clearESP(plr) end
            end
        end)
    makeToggle("ESP Level", function() return CONFIG.ESPShowLevel end,
        function(v) CONFIG.ESPShowLevel = v end)
    makeToggle("ESP PvP", function() return CONFIG.ESPShowPvP end,
        function(v) CONFIG.ESPShowPvP = v end)
    makeToggle("ESP HP", function() return CONFIG.ESPShowHP end,
        function(v) CONFIG.ESPShowHP = v end)
    makeToggle("ESP Dist", function() return CONFIG.ESPShowDist end,
        function(v) CONFIG.ESPShowDist = v end)

    -- MOVEMENT
    makeSection("Movement")
    makeToggle("Speed Hack", function() return CONFIG.SpeedEnabled end,
        function(v) CONFIG.SpeedEnabled = v applySpeed() end)
    makeToggle("Dash (Shift)", function() return CONFIG.DashEnabled end,
        function(v) CONFIG.DashEnabled = v end)
    makeToggle("Walk on Water", function() return CONFIG.WalkOnWater end,
        function(v)
            CONFIG.WalkOnWater = v
            setWalkOnWater(v)
        end)
    makeToggle("Infinite Energy", function() return CONFIG.InfiniteEnergy end,
        function(v) CONFIG.InfiniteEnergy = v end)

    -- COMBAT
    makeSection("Combat")
    makeToggle("Fast Attack", function() return CONFIG.FastAttack end,
        function(v) CONFIG.FastAttack = v end)

    task.defer(recalc)
end

buildHub()

